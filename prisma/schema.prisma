// Melles Cleaning Services — data model
// See docs/architecture.md for the full design rationale.
//
// Conventions:
// - Monetary values are stored as integer Tanzanian Shillings (TZS), never floats.
// - IDs are cuid strings generated by Prisma.
// - Timestamps are stored in UTC and rendered in Africa/Dar_es_Salaam.

generator client {
  provider     = "prisma-client"
  output       = "../src/lib/server/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  SUPERVISOR
  STAFF
  CLIENT
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTED
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  REFERRAL
  FLYER
  GOOGLE
  PHONE
  OTHER
}

enum ClientType {
  RESIDENTIAL
  COMMERCIAL
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum BookingStatus {
  SCHEDULED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  VERIFIED
  INVOICED
  PAID
  CANCELLED
}

enum RecurrenceFrequency {
  ONE_TIME
  WEEKLY
  BI_WEEKLY
  MONTHLY
}

enum AssignmentRole {
  LEAD
  SUPPORT
}

enum AssignmentStatus {
  ASSIGNED
  CONFIRMED
  COMPLETED
  NO_SHOW
}

enum ChecklistStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CASH
  MPESA
  TIGO_PESA
  AIRTEL_MONEY
  HALOPESA
  BANK_TRANSFER
  OTHER
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role      @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions         Session[]
  staffProfile     StaffProfile?
  auditLogs        AuditLog[]
  uploadedMedia    MediaAsset[]
  leadsAssigned    Lead[]
  contentRevisions ContentRevision[]
  paymentsReceived Payment[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model StaffProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  jobTitle    String?
  dailyRateTzs Int     @default(0)
  isAvailable Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams                TeamMember[]
  teamsLed             Team[]
  jobAssignments       JobAssignment[]
  checklistsSupervised JobChecklist[]
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  diffJson   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Content management
// ---------------------------------------------------------------------------

model Page {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  seoTitle       String?
  seoDescription String?
  status         PageStatus @default(DRAFT)
  publishedAt    DateTime?
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  contentBlocks ContentBlock[]
}

model ContentBlock {
  id          String  @id @default(cuid())
  pageId      String
  key         String
  blockType   String
  contentJson Json
  sortOrder   Int     @default(0)
  isVisible   Boolean @default(true)

  page      Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  revisions ContentRevision[]

  @@unique([pageId, key])
}

model ContentRevision {
  id             String   @id @default(cuid())
  contentBlockId String
  contentJson    Json
  authorId       String?
  createdAt      DateTime @default(now())

  contentBlock ContentBlock @relation(fields: [contentBlockId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([contentBlockId])
}

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String?
  bodyMarkdown     String?
  heroMediaId      String?
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  heroMedia       MediaAsset?      @relation(fields: [heroMediaId], references: [id], onDelete: SetNull)
  pricingPackages PricingPackage[]
  faqItems        FaqItem[]
  leads           Lead[]
  bookings        Booking[]
}

model PricingPackage {
  id          String  @id @default(cuid())
  serviceId   String
  name        String
  scope       String?
  priceMinTzs Int
  priceMaxTzs Int
  unit        String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model MediaAsset {
  id           String   @id @default(cuid())
  r2Key        String   @unique
  url          String
  mimeType     String
  width        Int?
  height       Int?
  sizeBytes    Int?
  altText      String?
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy     User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  galleryItems   GalleryItem[]
  testimonials   Testimonial[]
  serviceHeroes  Service[]
  checklistPhotos ChecklistResult[]
}

model GalleryItem {
  id           String   @id @default(cuid())
  mediaId      String
  caption      String?
  category     String?
  sortOrder    Int      @default(0)
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())

  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([isPublished, category])
}

model Testimonial {
  id             String   @id @default(cuid())
  clientName     String
  clientRole     String?
  quote          String
  rating         Int      @default(5)
  avatarMediaId  String?
  isPublished    Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  avatarMedia MediaAsset? @relation(fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@index([isPublished])
}

model FaqItem {
  id          String   @id @default(cuid())
  question    String
  answer      String
  serviceId   String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([isPublished])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// CRM: leads, clients, quotes
// ---------------------------------------------------------------------------

model Lead {
  id                String      @id @default(cuid())
  fullName          String
  phone             String
  email             String?
  segment           ClientType?
  serviceInterestId String?
  message           String?
  source            LeadSource  @default(WEBSITE)
  status            LeadStatus  @default(NEW)
  assignedToId      String?
  nextFollowUpAt    DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  serviceInterest Service? @relation(fields: [serviceInterestId], references: [id], onDelete: SetNull)
  assignedTo      User?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedClient Client?

  @@index([status])
  @@index([createdAt])
}

model Client {
  id          String       @id @default(cuid())
  leadId      String?      @unique
  displayName String
  clientType  ClientType   @default(RESIDENTIAL)
  addressLine String?
  area        String?
  city        String       @default("Dodoma")
  notes       String?
  status      ClientStatus @default(ACTIVE)
  since       DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lead     Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contacts ClientContact[]
  quotes   Quote[]
  bookings Booking[]
  invoices Invoice[]

  @@index([status])
}

model ClientContact {
  id        String  @id @default(cuid())
  clientId  String
  name      String
  role      String?
  phone     String
  email     String?
  isPrimary Boolean @default(false)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Quote {
  id          String      @id @default(cuid())
  clientId    String
  quoteNumber String      @unique
  status      QuoteStatus @default(DRAFT)
  subtotalTzs Int         @default(0)
  discountTzs Int         @default(0)
  totalTzs    Int         @default(0)
  validUntil  DateTime?
  notes       String?
  sentAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lineItems QuoteLineItem[]
  booking   Booking?

  @@index([clientId])
  @@index([status])
}

model QuoteLineItem {
  id           String @id @default(cuid())
  quoteId      String
  description  String
  quantity     Int    @default(1)
  unitPriceTzs Int
  lineTotalTzs Int
  sortOrder    Int    @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

// ---------------------------------------------------------------------------
// Operations: bookings, checklists, feedback
// ---------------------------------------------------------------------------

model Booking {
  id                  String              @id @default(cuid())
  clientId            String
  serviceId           String
  quoteId             String?             @unique
  bookingNumber       String              @unique
  status              BookingStatus       @default(SCHEDULED)
  scheduledStart      DateTime
  durationMinutes     Int                 @default(120)
  addressSnapshot     String?
  recurrenceFrequency RecurrenceFrequency @default(ONE_TIME)
  specialInstructions String?
  quotedTotalTzs      Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service     Service        @relation(fields: [serviceId], references: [id])
  quote       Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  assignments JobAssignment[]
  checklist   JobChecklist?
  invoice     Invoice?
  feedbacks   Feedback[]

  @@index([scheduledStart])
  @@index([status])
  @@index([clientId])
}

model Feedback {
  id          String   @id @default(cuid())
  bookingId   String
  rating      Int
  comment     String?
  isPublished Boolean  @default(false)
  submittedAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([isPublished])
}

// ---------------------------------------------------------------------------
// Staffing
// ---------------------------------------------------------------------------

model Team {
  id          String   @id @default(cuid())
  name        String
  leadStaffId String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  lead    StaffProfile? @relation(fields: [leadStaffId], references: [id], onDelete: SetNull)
  members TeamMember[]
}

model TeamMember {
  id              String  @id @default(cuid())
  teamId          String
  staffProfileId  String
  memberRole      String?

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([teamId, staffProfileId])
}

model JobAssignment {
  id             String           @id @default(cuid())
  bookingId      String
  staffProfileId String
  assignmentRole AssignmentRole   @default(SUPPORT)
  dayRateTzs     Int              @default(0)
  status         AssignmentStatus @default(ASSIGNED)
  createdAt      DateTime         @default(now())

  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([bookingId, staffProfileId])
}

// ---------------------------------------------------------------------------
// Quality control checklists
// ---------------------------------------------------------------------------

model ChecklistTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  appliesTo   ClientType?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items         ChecklistTemplateItem[]
  jobChecklists JobChecklist[]
}

model ChecklistTemplateItem {
  id         String  @id @default(cuid())
  templateId String
  section    String
  label      String
  guidance   String?
  sortOrder  Int     @default(0)
  isRequired Boolean @default(true)

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  results  ChecklistResult[]

  @@index([templateId])
}

model JobChecklist {
  id                 String          @id @default(cuid())
  bookingId          String          @unique
  templateId         String
  status             ChecklistStatus @default(PENDING)
  completedAt        DateTime?
  supervisorId       String?
  clientSignatureName String?
  signedOffAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  booking    Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  template   ChecklistTemplate  @relation(fields: [templateId], references: [id])
  supervisor StaffProfile?      @relation(fields: [supervisorId], references: [id], onDelete: SetNull)
  results    ChecklistResult[]
}

model ChecklistResult {
  id             String   @id @default(cuid())
  jobChecklistId String
  templateItemId String
  isChecked      Boolean  @default(false)
  note           String?
  photoMediaId   String?
  checkedAt      DateTime?

  jobChecklist JobChecklist          @relation(fields: [jobChecklistId], references: [id], onDelete: Cascade)
  templateItem ChecklistTemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Cascade)
  photoMedia   MediaAsset?           @relation(fields: [photoMediaId], references: [id], onDelete: SetNull)

  @@unique([jobChecklistId, templateItemId])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Invoice {
  id          String        @id @default(cuid())
  clientId    String
  bookingId   String?       @unique
  invoiceNumber String      @unique
  status      InvoiceStatus @default(DRAFT)
  subtotalTzs Int           @default(0)
  discountTzs Int           @default(0)
  totalTzs    Int           @default(0)
  dueDate     DateTime?
  issuedAt    DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  booking   Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@index([clientId])
  @@index([status])
}

model InvoiceLineItem {
  id           String @id @default(cuid())
  invoiceId    String
  description  String
  quantity     Int    @default(1)
  unitPriceTzs Int
  lineTotalTzs Int
  sortOrder    Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  amountTzs    Int
  method       PaymentMethod @default(CASH)
  reference    String?
  receivedById String?
  receivedAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedBy User?   @relation(fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([receivedAt])
}
