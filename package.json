{
	"name": "melles-cleaning",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.22.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie baseLocale --emit-ts-declarations --is-server \"import.meta.env.SSR\"",
		"check": "pnpm i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"db:seed": "prisma db seed",
		"postinstall": "prisma generate && pnpm i18n"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/plugin-message-format": "^4.4.4",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"dotenv": "^18.0.5",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"prisma": "7.10.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1146.0",
		"@aws-sdk/s3-request-presigner": "^3.1146.0",
		"@inlang/paraglide-js": "^2.25.4",
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"bcryptjs": "^3.0.3",
		"html2canvas-pro": "^2.5.2",
		"jspdf": "^4.2.1",
		"pg": "^8.23.1",
		"zod": "^4.6.5"
	}
}
