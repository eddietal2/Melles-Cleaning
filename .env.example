# Melles Cleaning Services — environment template
# Copy to .env and fill in real values. Never commit .env or real credentials here.

# --- Database (Neon Postgres) ---------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct connection used by Prisma Migrate (Neon pooler workaround).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- Auth -----------------------------------------------------------------
# 32+ byte random secret. Generate with: node -e "console.log(crypto.randomUUID())"
AUTH_SECRET="replace-me-with-a-long-random-secret"

# --- Public site ----------------------------------------------------------
PUBLIC_SITE_URL="http://localhost:5173"
PUBLIC_BUSINESS_PHONE="+255000000000"
PUBLIC_WHATSAPP_NUMBER="255000000000"

# --- Cloudflare R2 media --------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="melles-cleaning-media"
R2_PUBLIC_URL=""

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="Melles Cleaning Services <noreply@example.com>"
